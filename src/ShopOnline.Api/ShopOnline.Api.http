@baseUrl = http://localhost:5090

### Categories
GET {{baseUrl}}/categories

### Sizes
GET {{baseUrl}}/sizes

### Products
GET {{baseUrl}}/products

### Men's pants, price desc
GET {{baseUrl}}/products?categoryId=3&genderId=2&sortBy=PriceDesc

### 50 - 130, size M in stock
GET {{baseUrl}}/products?minPrice=50&maxPrice=130&sizeId=3

### Add product
POST {{baseUrl}}/products
Content-Type: application/json

{
    "name": "Summer Pique Polo",
    "price": 129.99,
    "subcategoryId": 3,
    "colorId": 2,
    "collectionId": 2,
    "genderId": 2,
    "sizes": [
        { "sizeId": 3, "stock": 10 },
        { "sizeId": 4, "stock": 6 }
    ]
}

> {% client.global.set("productId", response.body.id); %}

### Get product
GET {{baseUrl}}/products/{{productId}}

### Update product
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json

{
    "name": "Summer Pique Polo",
    "price": 99.99,
    "subcategoryId": 3,
    "colorId": 2,
    "collectionId": 2,
    "genderId": 2,
    "sizes": [
        { "sizeId": 3, "stock": 4 },
        { "sizeId": 4, "stock": 0 }
    ]
}

### Delete product
DELETE {{baseUrl}}/products/{{productId}}

### Invalid product
POST {{baseUrl}}/products
Content-Type: application/json

{
    "name": "",
    "price": -10,
    "subcategoryId": 1,
    "colorId": 9999,
    "collectionId": null,
    "genderId": 1,
    "sizes": []
}
